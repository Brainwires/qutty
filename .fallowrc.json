{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "app/page.tsx",
    "app/layout.tsx",
    "desktop.ts",
    "desktop/*.ts",
    "denext.config.ts",
    "scripts/*.ts",
    "tests/**/*_test.ts",
    "lib/**/*_test.ts"
  ],
  // scripts/package-*.ts are generated by Denext (`deno task desktop:scripts`), not ours to refactor.
  // public/ holds the favicon and stylesheets linked from app/layout.tsx's <head>, which the
  // module graph can't see. vendor/ is third-party code (the xterm.js ESM builds).
  "ignorePatterns": [
    "vendor/**",
    "public/**",
    "scripts/package-*.ts",
    "dist/**",
    "out/**",
    ".deno-desktop/**",
    ".denext/**"
  ],
  // deno.json maps @xterm/* to vendor/xterm/*.mjs, which is excluded above, so fallow can't
  // follow lib/xterm.ts's re-exports. lib/terminal-manager.ts consumes all of them.
  "ignoreUnresolvedImports": ["./vendor/xterm/**"],
  // Declared in deno.json's import map (npm:node-pty), which fallow doesn't read.
  "ignoreDependencies": ["node-pty"],
  "ignoreExports": [{ "file": "lib/xterm.ts", "exports": ["*"] }],
  "rules": {
    // Syntactic only: it misses calls made through a typed parameter (`manager.setFont()`,
    // the e2e harness's `app.lastLine()`), which is how both classes are used.
    "unused-class-members": "off"
  }
}
