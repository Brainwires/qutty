#!/usr/bin/env bash
# qutty-hook [harness]: a Claude Code (or compatible) hook command for the Qutty agent hub. It
# sends the hook's JSON input (stdin) to this tile's hub socket ($QUTTY_SOCK) as one line and
# prints the hub's one-line JSON reply (pending messages as context, or a Stop block) as the
# hook's output. Outside Qutty, or when the hub cannot be reached, it prints nothing and exits 0,
# so the agent carries on as if there were no hook. Installed to ~/.qutty/bin by Qutty.
#
# qutty-hook say <text...> [--mood neutral|thinking|attention|success|confused|mad|sad|excited|
#                sleepy|love|surprised|shocked|wow] [--action id:label]... [--timeout ms] [--wait]
# makes Loopy, the window's companion, say something (the `loopy-say` shape). --wait prints the
# id of the button pressed (nothing when the bubble was closed). A refused message is reported
# on stderr with exit code 1.
#
# In the shared Docker sandbox the hub is reached over TCP instead ($QUTTY_HUB, host:port), the
# tile's token ($QUTTY_TILE_TOKEN) sent as the first line.
if [ -n "${QUTTY_SOCK:-}" ] && [ -S "$QUTTY_SOCK" ]; then
  unset QUTTY_HUB
elif [ -z "${QUTTY_HUB:-}" ] || [ -z "${QUTTY_TILE_TOKEN:-}" ]; then
  exit 0
fi

# The TCP half of ask_hub: bash's /dev/tcp, else nc. A refused token's reply is dropped.
ask_tcp() {
  local host="${QUTTY_HUB%:*}" port="${QUTTY_HUB##*:}" reply=""
  if exec 3<>"/dev/tcp/$host/$port"; then
    printf '%s\n%s\n' "$QUTTY_TILE_TOKEN" "$2" >&3
    IFS= read -r -t "$1" reply <&3
    exec 3>&-
  elif command -v nc >/dev/null 2>&1; then
    reply="$(printf '%s\n%s\n' "$QUTTY_TILE_TOKEN" "$2" | nc -w "$1" "$host" "$port" | head -n 1)"
  fi
  case "$reply" in '' | *'"jsonrpc"'*) ;; *) printf '%s\n' "$reply" ;; esac
} 2>/dev/null

# Send one line to the hub, print the first line back. $1: idle timeout in seconds.
ask_hub() {
  if [ -n "${QUTTY_HUB:-}" ]; then
    ask_tcp "$@"
  elif command -v nc >/dev/null 2>&1 && nc -h 2>&1 | grep -q -- '-U'; then
    printf '%s\n' "$2" | nc -w "$1" -U "$QUTTY_SOCK" 2>/dev/null | head -n 1
  elif command -v socat >/dev/null 2>&1; then
    printf '%s\n' "$2" | socat -t "$1" - "UNIX-CONNECT:$QUTTY_SOCK" 2>/dev/null | head -n 1
  fi
}

# A JSON string for $1 (control characters other than tab and newline are dropped).
json_str() {
  local s
  s="$(printf '%s' "$1" | LC_ALL=C tr -d '\000-\010\013\014\016-\037')"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\n'/\\n}"
  printf '"%s"' "$s"
}

if [ "${1:-}" = "say" ]; then
  shift
  wait_for=10
  args=""
  for a in "$@"; do
    [ "$a" = "--wait" ] && wait_for=130
    args="${args:+$args,}$(json_str "$a")"
  done
  reply="$(ask_hub "$wait_for" "{\"qutty\":\"say\",\"args\":[$args]}")"
  case "$reply" in
    *'"error":'*)
      printf 'qutty-hook say: %s\n' "$(printf '%s' "$reply" | sed -n 's/.*"error":"\(.*\)"}$/\1/p')" >&2
      exit 1 ;;
    *'"action":"'*) printf '%s\n' "$(printf '%s' "$reply" | sed -n 's/.*"action":"\([^"]*\)".*/\1/p')" ;;
  esac
  exit 0
fi

harness="${1:-}"
case "$harness" in *[!A-Za-z0-9._-]*) harness="" ;; esac
# One JSON object; a raw newline cannot occur inside a JSON string, so dropping them is safe.
input="$(tr -d '\r\n')"
[ -n "$input" ] || input="null"
reply="$(ask_hub 10 "{\"qutty\":\"hook\",\"harness\":\"$harness\",\"input\":$input}")"
case "$reply" in "{"*) printf '%s\n' "$reply" ;; esac
exit 0
