{
  "desktop": {
    "app": {
      "identifier": "org.qutty.Qutty",
      "name": "Qutty",
      "icons": {
        "macos": "./icons/app.icns",
        "windows": "./icons/app.ico",
        "linux": "./icons/app.png"
      },
      "keepAlive": true,
      "singleInstance": true,
      "restoreWindows": true,
      "maxWindows": 16
    },
    "installers": {
      "publisher": "Brainwires",
      "email": "155631428+Brainwires@users.noreply.github.com",
      "description": "A tiling terminal: the terminal you are using gets the most space"
    },
    "linux": {
      "desktopEntry": {
        "categories": [
          "System",
          "TerminalEmulator"
        ],
        "keywords": [
          "terminal",
          "shell",
          "console",
          "command line",
          "tiling",
          "ssh"
        ],
        "genericName": "Terminal",
        "startupWMClass": "org.qutty.Qutty"
      }
    },
    "window": {
      "width": 1600,
      "height": 1000,
      "title": "Qutty",
      "key": "main"
    },
    "menu": {
      "window": {
        "newWindow": "/",
        "reopenClosed": "list",
        "list": true,
        "items": [
          {
            "id": "qutty:window:close-end",
            "label": "Close Window and End Its Shells"
          },
          {
            "id": "qutty:tile:minimize",
            "label": "Minimize Tile"
          },
          {
            "id": "qutty:tile:zoom",
            "label": "Zoom Tile"
          },
          {
            "id": "qutty:view:tiled",
            "label": "Tiled View"
          },
          {
            "id": "qutty:view:freeform",
            "label": "Free-form View"
          },
          {
            "id": "qutty:arrange:cascade",
            "label": "Cascade Tiles"
          },
          {
            "id": "qutty:arrange:rows",
            "label": "Arrange Tiles in Rows"
          },
          {
            "id": "qutty:arrange:columns",
            "label": "Arrange Tiles in Columns"
          }
        ]
      }
    },
    "titleBar": "hiddenInset",
    "capabilities": {
      "extensions": [
        "./desktop/pty.ts",
        "./desktop/session.ts",
        "./desktop/ssh.ts",
        "./desktop/hub.ts",
        "./desktop/sandbox.ts",
        "./desktop/voice.ts",
        "./desktop/ollama.ts",
        "./desktop/links.ts"
      ],
      "systemStats": true,
      "microphone": {
        "usageDescription": "Qutty listens only while you hold the talk key or the mic button, to turn your speech into text for the companion or the focused tile."
      },
      "secureStore": true
    },
    "secureStore": {
      "legacy": false
    },
    "extraPermissions": {
      "ffi": [
        "*"
      ],
      "netConnect": [
        "127.0.0.1:11434",
        "api.deepgram.com",
        "api.elevenlabs.io",
        "api.anthropic.com"
      ]
    }
  }
}
