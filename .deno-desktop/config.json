{
  "desktop": {
    "app": {
      "identifier": "org.qutty.Qutty",
      "name": "Qutty",
      "icons": {
        "macos": "./icons/app.icns",
        "windows": "./icons/app.ico",
        "linux": "./icons/app.png"
      },
      "keepAlive": true,
      "singleInstance": true,
      "restoreWindows": true,
      "maxWindows": 16
    },
    "installers": {
      "publisher": "Brainwires",
      "email": "155631428+Brainwires@users.noreply.github.com",
      "description": "A tiling terminal: the terminal you are using gets the most space"
    },
    "linux": {
      "desktopEntry": {
        "categories": [
          "System",
          "TerminalEmulator"
        ],
        "keywords": [
          "terminal",
          "shell",
          "console",
          "command line",
          "tiling",
          "ssh"
        ],
        "genericName": "Terminal",
        "startupWMClass": "org.qutty.Qutty"
      }
    },
    "window": {
      "width": 1600,
      "height": 1000,
      "title": "Qutty",
      "key": "main"
    },
    "menu": {
      "window": {
        "reopenClosed": "list",
        "list": true
      }
    },
    "titleBar": "hiddenInset",
    "webViews": {
      "limit": 16
    },
    "capabilities": {
      "extensions": [
        "./desktop/pty.ts",
        "./desktop/session.ts",
        "./desktop/ssh.ts",
        "./desktop/hub.ts",
        "./desktop/sandbox.ts",
        "./desktop/voice.ts",
        "./desktop/ollama.ts",
        "./desktop/links.ts",
        "./desktop/skins.ts",
        "./desktop/companion-looks.ts",
        "./desktop/scm.ts"
      ],
      "systemStats": true,
      "microphone": {
        "usageDescription": "Qutty listens only while you hold the talk key or the mic button, to turn your speech into text for the companion or the focused tile."
      },
      "secureStore": true
    },
    "sidecars": [
      {
        "name": "ptyd",
        "run": {
          "module": "./desktop/ptyd-sidecar.ts"
        },
        "ready": {
          "signal": true,
          "timeoutMs": 10000
        },
        "restart": {
          "on": "never"
        }
      }
    ],
    "secureStore": {
      "legacy": false
    },
    "extraPermissions": {
      "run": [
        "*"
      ],
      "ffi": [
        "*"
      ],
      "netConnect": [
        "127.0.0.1:11434",
        "api.deepgram.com",
        "api.elevenlabs.io",
        "api.anthropic.com"
      ]
    }
  }
}
