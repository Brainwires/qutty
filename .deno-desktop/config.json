{
  "desktop": {
    "app": {
      "identifier": "org.qutty.Qutty",
      "name": "Qutty",
      "icons": {
        "macos": "./icons/app.icns",
        "windows": "./icons/app.ico",
        "linux": "./icons/app.png"
      },
      "keepAlive": true,
      "restoreWindows": true,
      "maxWindows": 16
    },
    "window": {
      "width": 1600,
      "height": 1000,
      "title": "Qutty",
      "key": "main"
    },
    "menu": {
      "window": {
        "newWindow": "/",
        "reopenClosed": true,
        "list": true
      }
    },
    "titleBar": "hiddenInset",
    "capabilities": {
      "extensions": [
        "./desktop/pty.ts",
        "./desktop/session.ts",
        "./desktop/ssh.ts",
        "./desktop/hub.ts",
        "./desktop/sandbox.ts",
        "./desktop/voice.ts",
        "./desktop/ollama.ts",
        "./desktop/links.ts"
      ],
      "microphone": {
        "usageDescription": "Qutty listens only while you hold the talk key or the mic button, to turn your speech into text for the companion or the focused tile."
      }
    },
    "extraPermissions": {
      "ffi": [
        "*"
      ],
      "netConnect": [
        "127.0.0.1:11434"
      ]
    }
  }
}
