{
  "desktop": {
    "app": {
      "identifier": "org.qutty.Qutty",
      "name": "Qutty",
      "icons": {
        "macos": "./icons/app.icns",
        "windows": "./icons/app.ico",
        "linux": "./icons/app.png"
      }
    },
    "window": {
      "width": 1600,
      "height": 1000,
      "title": "Qutty"
    },
    "titleBar": "hiddenInset",
    "capabilities": {
      "extensions": [
        "./desktop/pty.ts",
        "./desktop/ssh.ts",
        "./desktop/hub.ts",
        "./desktop/sandbox.ts",
        "./desktop/voice.ts",
        "./desktop/ollama.ts"
      ],
      "microphone": {
        "usageDescription": "Qutty listens only while you hold the talk key or the mic button, to turn your speech into text for the companion or the focused tile."
      }
    },
    "extraPermissions": {
      "ffi": [
        "*"
      ],
      "netConnect": [
        "127.0.0.1:11434"
      ]
    }
  }
}
